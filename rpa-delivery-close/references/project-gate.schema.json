{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redballoom.github.io/schemas/project-gate.schema.json",
  "title": "Project Gate Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "current_gate",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "current_gate": {
      "enum": ["G0", "G1", "G2", "G3", "G4", "G5"]
    },
    "status": {
      "enum": ["active", "operational", "archived", "terminated"]
    },
    "accepted_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "gate", "event", "event_id", "accepted_at"],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "gate": {
          "enum": ["G0", "G1", "G2", "G3", "G4", "G5"]
        },
        "event": {
          "enum": ["gate-close", "gate-revalidation", "gate-amendment"]
        },
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "accepted_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
