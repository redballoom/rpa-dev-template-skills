{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redballoom.github.io/schemas/hermes-project.schema.json",
  "title": "Hermes Project Gate Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "current_gate",
    "status",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "current_gate": {
      "enum": ["G0", "G1", "G2", "G3", "G4", "G5"]
    },
    "status": {
      "enum": ["active", "operational", "archived", "terminated"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
